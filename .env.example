# Production CMS backend: "github" (Phase A) or "git-gateway" (Phase B).
# Ignored in local dev — the admin UI uses local_backend + decap-server.
PUBLIC_CMS_BACKEND=github

# GitHub OAuth App (Phase A). Client ID is public; secret is only for the Netlify function.
# Redirect URI / callback must match GITHUB_OAUTH_REDIRECT_URI exactly:
#   https://dev-test-whfumc.netlify.app/.netlify/functions/auth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://dev-test-whfumc.netlify.app/.netlify/functions/auth
