# Production CMS backend: "github" (Phase A) or "git-gateway" (Phase B).
# Ignored in local dev — the admin UI uses local_backend + decap-server.
PUBLIC_CMS_BACKEND=github

# GitHub OAuth App client ID for PKCE (Phase A). Not a secret.
# Create an OAuth App with callbacks:
#   http://localhost:4321/admin/
#   https://<your-site>.netlify.app/admin/
PUBLIC_GITHUB_APP_ID=
