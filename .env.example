# Production CMS backend: "github" (Phase A) or "git-gateway" (Phase B).
# Ignored in local dev — the admin UI uses local_backend + decap-server.
PUBLIC_CMS_BACKEND=github

# GitHub OAuth App (Phase A). Client ID is public; secret is only for the Netlify function.
# Authorization callback URL must be:
#   https://<your-site>.netlify.app/.netlify/functions/auth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must match the GitHub OAuth app Redirect URI exactly (no trailing slash):
GITHUB_OAUTH_REDIRECT_URI=https://dev-test-whufmc.netlify.app/.netlify/functions/auth
